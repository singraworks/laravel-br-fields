{
    "name": "singraworks/laravel-br-fields",
    "description": "Laravel validation rules and Eloquent casts for Brazilian CPF and CNPJ numbers, on top of singraworks/br-fields.",
    "type": "library",
    "keywords": [
        "laravel",
        "brazil",
        "brasil",
        "cpf",
        "cnpj",
        "validation",
        "eloquent",
        "cast",
        "lgpd"
    ],
    "homepage": "https://github.com/singraworks/laravel-br-fields",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Vasconcelos",
            "email": "lucasvscn@pm.me"
        }
    ],
    "support": {
        "issues": "https://github.com/singraworks/laravel-br-fields/issues",
        "source": "https://github.com/singraworks/laravel-br-fields"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/translation": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "singraworks/br-fields": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/vet": "^0.2.1",
        "orchestra/testbench": "^10.12 || ^11.0",
        "pestphp/pest": "^4.7.8 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.4 || ^5.0",
        "phpstan/phpstan": "^2.3.1",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-master"
    },
    "conflict": {
        "brianium/paratest": "7.26.1"
    },
    "autoload": {
        "psr-4": {
            "SingraWorks\\LaravelBrFields\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SingraWorks\\LaravelBrFields\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SingraWorks\\LaravelBrFields\\BrFieldsServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "@php -d memory_limit=-1 vendor/bin/phpstan analyse",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --parallel --test"
        ],
        "test:type-coverage": "@php -d memory_limit=-1 vendor/bin/pest --parallel --type-coverage --min=100",
        "test:coverage": "@php -d memory_limit=-1 vendor/bin/pest --parallel --coverage --min=95",
        "test:mutate": "@php -d memory_limit=-1 vendor/bin/pest --parallel --mutate --covered-only --min=85",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": [
            "@test:lint",
            "@analyse",
            "@test:type-coverage",
            "@test:coverage"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
